<resources>

    <!-- The panel's default colours. Every default resolves under any theme, Material or not; a
         host overrides any subset through the currencyCalculatorStyle theme attribute. -->
    <style name="Widget.CurrencyEditText.Calculator" parent="">
        <item name="calculatorPanelBackgroundColor">?android:attr/colorBackground</item>
        <item name="calculatorPanelStrokeColor">?android:attr/colorControlHighlight</item>
        <item name="calculatorExpressionTextColor">?android:attr/textColorPrimary</item>
        <item name="calculatorErrorTextColor">?attr/colorError</item>
        <item name="calculatorKeyTextColor">?android:attr/textColorPrimary</item>
        <item name="calculatorOperatorTextColor">@color/currency_calculator_key_primary</item>
        <!-- The two fills are opt-in: named, the panel looks exactly as it did without them. -->
        <item name="calculatorExpressionBackgroundColor">@android:color/transparent</item>
        <item name="calculatorEqualsBackgroundColor">@android:color/transparent</item>
        <!-- So is the line between the keys: unnamed, the keys are spaced and nothing is drawn. -->
        <item name="calculatorKeyBorderColor">@android:color/transparent</item>
        <item name="calculatorKeySize">56dp</item>
    </style>

    <!-- Shared by every calculator key. The square the key is laid out at comes from
         calculatorKeySize and is set on the view, since a style cannot read a theme dimension. -->
    <style name="CurrencyCalculatorKey" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <!-- A key is laid out at an exact size, so the button's own padding would only crowd the
             label: "( )" does not fit a 56dp key with 16dp of it taken from each side. -->
        <item name="android:padding">0dp</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
