<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="currencySymbol" format="string" />
    <attr name="localeTag" format="string" />
    <attr name="decimalSeparator" format="string" />
    <attr name="groupingSeparator" format="string" />
    <attr name="useCurrencySymbolAsHint" format="boolean" />
    <attr name="negativeValueAllow" format="boolean" />
    <attr name="maxNumberOfDecimalPlaces" format="integer" />
    <attr name="decimalZerosPadding" format="boolean" />
    <attr name="emptyStringForZero" format="boolean" />
    <attr name="calculatorEnabled" format="boolean" />

    <!-- The style the calculator panel takes its look from. Set it on the field's own
         android:theme overlay to give one field its own panel. -->
    <attr name="currencyCalculatorStyle" format="reference" />

    <!-- What the calculator panel is drawn from: its colour roles, and the size of a key. Every
         one of them has a default that resolves under any theme, so a host overrides the ones it
         cares about and leaves the rest. -->
    <declare-styleable name="CurrencyCalculator">
        <attr name="calculatorPanelBackgroundColor" format="reference|color" />
        <!-- The panel's 1dp edge, which is all that separates it from a window of the same colour. -->
        <attr name="calculatorPanelStrokeColor" format="reference|color" />
        <attr name="calculatorExpressionTextColor" format="reference|color" />
        <!-- The fill behind the expression line; transparent by default. -->
        <attr name="calculatorExpressionBackgroundColor" format="reference|color" />
        <attr name="calculatorErrorTextColor" format="reference|color" />
        <!-- Digits and the decimal separator. -->
        <attr name="calculatorKeyTextColor" format="reference|color" />
        <!-- Operators, sign, backspace, clear and equals. -->
        <attr name="calculatorOperatorTextColor" format="reference|color" />
        <!-- The fill behind the equals key; transparent by default, which leaves the key flat. -->
        <attr name="calculatorEqualsBackgroundColor" format="reference|color" />
        <!-- The equals key's label. Follows calculatorOperatorTextColor where it is not named. -->
        <attr name="calculatorEqualsTextColor" format="reference|color" />
        <!-- The 1dp line between the keys; transparent by default, which leaves them only spaced. -->
        <attr name="calculatorKeyBorderColor" format="reference|color" />
        <!-- The side of a key, which every key shares. Four of them plus the panel's padding are
             what the panel is wide. -->
        <attr name="calculatorKeySize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CurrencyEditText">
        <attr name="currencySymbol" />
        <attr name="localeTag" />
        <attr name="decimalSeparator" />
        <attr name="groupingSeparator" />
        <attr name="useCurrencySymbolAsHint" />
        <attr name="negativeValueAllow" />
        <attr name="decimalZerosPadding" />
        <attr name="maxNumberOfDecimalPlaces" />
        <attr name="emptyStringForZero" />
        <attr name="calculatorEnabled" />
    </declare-styleable>
    <declare-styleable name="CurrencyMaterialEditText">
        <attr name="text" format="string" />
        <attr name="selectAllOnFocus" format="boolean" />
        <attr name="currencySymbol" />
        <attr name="localeTag" />
        <attr name="decimalSeparator" />
        <attr name="groupingSeparator" />
        <attr name="useCurrencySymbolAsHint" />
        <attr name="negativeValueAllow" />
        <attr name="decimalZerosPadding" />
        <attr name="maxNumberOfDecimalPlaces" />
        <attr name="emptyStringForZero" />
        <attr name="calculatorEnabled" />
    </declare-styleable>
</resources>