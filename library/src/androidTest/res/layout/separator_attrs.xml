<!--
  Each field names one separator and leaves the other to the locale. The locale is named too, so
  the separator the field does not set is the same on any device.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ru.pravbeseda.currencyedittext.CurrencyEditText
        android:id="@+id/plain_with_decimal_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:decimalSeparator="."
        app:localeTag="ru" />

    <ru.pravbeseda.currencyedittext.CurrencyMaterialEditText
        android:id="@+id/material_with_decimal_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:decimalSeparator="."
        app:localeTag="ru" />

    <ru.pravbeseda.currencyedittext.CurrencyEditText
        android:id="@+id/plain_with_grouping_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:groupingSeparator="'"
        app:localeTag="ru" />

    <ru.pravbeseda.currencyedittext.CurrencyMaterialEditText
        android:id="@+id/material_with_grouping_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:groupingSeparator="'"
        app:localeTag="ru" />

    <ru.pravbeseda.currencyedittext.CurrencyEditText
        android:id="@+id/plain_with_clashing_separators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:decimalSeparator="."
        app:groupingSeparator="."
        app:localeTag="ru" />

    <ru.pravbeseda.currencyedittext.CurrencyMaterialEditText
        android:id="@+id/material_with_clashing_separators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:decimalSeparator="."
        app:groupingSeparator="."
        app:localeTag="ru" />

</LinearLayout>
